# Bobertを手元で動かすための設定(wrangler dev が読み込む)。
# このファイルを .env にコピーして値を入れる。.env はGitに入れない(.gitignore で除外済み)。
# Cloudflare上の値は「wrangler secret put <名前>」で設定する(本番は --env production を付ける)。
# 準備の手順: docs/setup.md

# --- Discord(開発用のアプリ) ---
# Developer Portal > General Information の Application ID
DISCORD_APPLICATION_ID=
# Developer Portal > General Information の Public Key(Interactionsの署名の確認に使う)
DISCORD_PUBLIC_KEY=
# Developer Portal > Bot で発行したトークン
DISCORD_BOT_TOKEN=

# --- 運用 ---
# 管理用エンドポイント(Gatewayの起動と状態確認)を呼ぶためのトークン。長いランダムな文字列にする。
# 作り方の例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# 障害の通知先(開発者用チャンネルのWebhook URL)
ALERT_WEBHOOK_URL=

# --- 登録されたAPIキーの暗号化 ---
# 「番号:鍵」をカンマ区切りで並べる(例: 1:xxxx,2:yyyy)。鍵は32バイトの乱数をBase64にしたもの。
# 新しく暗号化するときは番号が最大の鍵を使い、古い鍵は復号のためだけに残す(鍵の入れ替え)。
# 鍵の作り方の例: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEYS=1:
