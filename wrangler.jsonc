{
	"$schema": "node_modules/wrangler/config-schema.json",
	// 既定は開発用の環境。本番用は「--env production」で使う(下のenv.production)。
	// 構成の仕様: docs/spec/architecture.md
	"name": "bobert-dev",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ENVIRONMENT": "development"
	},
	// 手元では .env、Cloudflare上では「wrangler secret put」で設定する(.env.example を参照)
	"secrets": {
		"required": [
			"DISCORD_APPLICATION_ID",
			"DISCORD_PUBLIC_KEY",
			"DISCORD_BOT_TOKEN",
			"ADMIN_TOKEN",
			"ALERT_WEBHOOK_URL",
			"CREDENTIAL_ENCRYPTION_KEYS",
			// エージェントのGitHubとの連携に使う、Bobert用のGitHub App(docs/setup.md「GitHub App」)
			"GITHUB_APP_CLIENT_ID",
			"GITHUB_APP_CLIENT_SECRET",
			"GITHUB_APP_SLUG"
		]
	},
	// Discord Gatewayへの常時接続を持つDurable Objectと、/importの進み具合を見張るDurable Object、
	// エージェントのチャンネルごとに、Managed Agentsのセッションとのやり取りを受け持つDurable Object
	"durable_objects": {
		"bindings": [
			{ "name": "GATEWAY", "class_name": "Gateway" },
			{ "name": "IMPORT_PROGRESS", "class_name": "ImportProgress" },
			{ "name": "AGENT_SESSION", "class_name": "AgentSession" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Gateway"] },
		{ "tag": "v2", "new_sqlite_classes": ["ImportProgress"] },
		{ "tag": "v3", "new_sqlite_classes": ["AgentSession"] }
	],
	"queues": {
		"producers": [
			{ "binding": "RESPOND_QUEUE", "queue": "bobert-respond-dev" },
			{ "binding": "INGEST_QUEUE", "queue": "bobert-ingest-dev" }
		],
		"consumers": [
			// 応答の生成(LLMの呼び出し)。1件ずつ処理する
			{ "queue": "bobert-respond-dev", "max_batch_size": 1, "max_retries": 2 },
			// メッセージの保存とベクトル化、削除の反映、過去ログの取り込み
			{
				"queue": "bobert-ingest-dev",
				"max_batch_size": 50,
				"max_batch_timeout": 5,
				"max_retries": 5
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bobert-dev",
			// 北米東部(enam)に作成。DiscordとGatewayのDurable Objectに近い場所に置くため
			"database_id": "484b6a27-1fd5-4fec-9a38-4850e0835f05",
			"migrations_dir": "migrations"
		}
	],
	// VectorizeとWorkers AIは手元で再現できないため、開発用のリソースにつなぐ
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "bobert-messages-dev",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"env": {
		"production": {
			"name": "bobert",
			"vars": {
				"ENVIRONMENT": "production"
			},
			"secrets": {
				"required": [
					"DISCORD_APPLICATION_ID",
					"DISCORD_PUBLIC_KEY",
					"DISCORD_BOT_TOKEN",
					"ADMIN_TOKEN",
					"ALERT_WEBHOOK_URL",
					"CREDENTIAL_ENCRYPTION_KEYS",
					"GITHUB_APP_CLIENT_ID",
					"GITHUB_APP_CLIENT_SECRET",
					"GITHUB_APP_SLUG"
				]
			},
			"durable_objects": {
				"bindings": [
					{ "name": "GATEWAY", "class_name": "Gateway" },
					{ "name": "IMPORT_PROGRESS", "class_name": "ImportProgress" },
					{ "name": "AGENT_SESSION", "class_name": "AgentSession" }
				]
			},
			"migrations": [
				{ "tag": "v1", "new_sqlite_classes": ["Gateway"] },
				{ "tag": "v2", "new_sqlite_classes": ["ImportProgress"] },
				{ "tag": "v3", "new_sqlite_classes": ["AgentSession"] }
			],
			"queues": {
				"producers": [
					{ "binding": "RESPOND_QUEUE", "queue": "bobert-respond" },
					{ "binding": "INGEST_QUEUE", "queue": "bobert-ingest" }
				],
				"consumers": [
					{ "queue": "bobert-respond", "max_batch_size": 1, "max_retries": 2 },
					{
						"queue": "bobert-ingest",
						"max_batch_size": 50,
						"max_batch_timeout": 5,
						"max_retries": 5
					}
				]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "bobert",
					// 北米東部(enam)に作成(2026-10-29)
					"database_id": "f31cbdb4-5ca6-4c1f-8c46-e308030e5f52",
					"migrations_dir": "migrations"
				}
			],
			"vectorize": [
				{
					"binding": "VECTORIZE",
					"index_name": "bobert-messages",
					"remote": true
				}
			],
			"ai": {
				"binding": "AI",
				"remote": true
			}
		}
	}
}
